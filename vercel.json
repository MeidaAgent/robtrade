{
  "version": 2,
  "buildCommand": "npm --prefix backend install && npm --prefix backend run vercel-build",
  "outputDirectory": "frontend",
  "routes": [
    {
      "src": "/(health|config|ready|auth|vault|swap|settlement)(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/app/(.*\\.(css|js|woff2|woff|png|jpg|jpeg|gif|svg|ico|txt|xml|json))",
      "handle": "filesystem"
    },
    {
      "src": "/app/(.*)",
      "dest": "/app/index.html"
    },
    {
      "src": "/sdk/(.*\\.(css|js|woff2|woff|png|jpg|jpeg|gif|svg|ico|txt|xml|json))",
      "handle": "filesystem"
    },
    {
      "src": "/sdk/(.*)",
      "dest": "/sdk/index.html"
    },
    {
      "src": "/docs/(.*\\.(css|js|woff2|woff|png|jpg|jpeg|gif|svg|ico|txt|xml|json))",
      "handle": "filesystem"
    },
    {
      "src": "/docs/(.*)",
      "dest": "/docs/index.html"
    },
    {
      "src": "/whitepaper/(.*\\.(css|js|woff2|woff|png|jpg|jpeg|gif|svg|ico|txt|xml|json))",
      "handle": "filesystem"
    },
    {
      "src": "/whitepaper/(.*)",
      "dest": "/whitepaper/index.html"
    },
    {
      "src": "/privacy/(.*)",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/cookies/(.*)",
      "dest": "/cookies/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}