{
  "version": 2,
  "buildCommand": "npm --prefix backend install && npm --prefix backend run vercel-build",
  "outputDirectory": "frontend",
  "routes": [
    {
      "src": "/(health|config|ready|auth|vault|swap|settlement)(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/\\.(css|js|woff2|woff|png|jpg|jpeg|gif|svg|ico|webp|json)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/app/(.*)",
      "dest": "/app/index.html"
    },
    {
      "src": "/sdk/(.*)",
      "dest": "/sdk/index.html"
    },
    {
      "src": "/docs/(.*)",
      "dest": "/docs/index.html"
    },
    {
      "src": "/whitepaper/(.*)",
      "dest": "/whitepaper/index.html"
    },
    {
      "src": "/privacy/(.*)",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/cookies/(.*)",
      "dest": "/cookies/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}