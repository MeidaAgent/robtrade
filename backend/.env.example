# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/robtrade?schema=public"

# EVM chain
CHAIN_NAME="Robinhood Chain"
CHAIN_ID=4663
CHAIN_RPC_URL="https://robinhood.drpc.org"

# Contracts — MUST point to audited deployments before enabling real funds
SHIELDED_POOL_CONTRACT_ADDRESS=
PROOF_VERIFIER_ADDRESS=
SETTLEMENT_CONTRACT_ADDRESS=
PRIVACY_MODE=scaffold

# Swap provider
ZEROX_API_KEY=
ZEROX_API_URL="https://api.0x.org/swap/v1/quote" # Set this to the provider endpoint/version enabled for your target chain; adapter sends 0x-version: 2
ONEINCH_API_KEY=

# Auth / security
# Production: CORS_ORIGIN=https://www.robtrade.trade, SIWE_DOMAIN=www.robtrade.trade, SIWE_URI=https://www.robtrade.trade
CORS_ORIGIN="http://localhost:3000"
SIWE_DOMAIN="localhost:3000"
SIWE_URI="http://localhost:3000"

# Swap safety
SWAP_QUOTE_TTL_SECONDS=60
SWAP_MAX_SLIPPAGE_BPS=50

# Indexer
# Leave empty to start from the first finalized block after initial boot.
INDEXER_START_BLOCK=
INDEXER_POLL_MS=10000
INDEXER_CHUNK_SIZE=1000
INDEXER_CONFIRMATIONS=3
INDEXER_REORG_REWIND_BLOCKS=20
